# Copy this file to backend/.env for local development.
# Never commit real credentials.

GEMINI_API_KEY=
LLM_MODEL=gemini-3-flash-preview
LLM_CODER_MODEL=gemini-3-flash-preview
GEMINI_THINKING_LEVEL=medium

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=deepstudy-dev-only

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

SQLITE_DB_PATH=./backend/storage/deepstudy.db
VECTOR_STORE_PATH=./backend/storage/vector_store
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

API_HOST=0.0.0.0
API_PORT=8000
